rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helpers
    // =========================
    function signedIn() {
      return request.auth != null;
    }

    // Admin = user has a doc in /admins/{uid}
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // =========================
    // Notifications 
    // =========================
    match /users/{userId}/notifications/{notifId} {
      allow read, write: if signedIn();
    }


    // =========================
    // Devices
    // =========================
    match /devices/{deviceId} {
      // If you want any signed-in user to read/write their device doc, keep as-is.
      // If you want to restrict per-user, you need an owner field and check it.
      allow read, write: if signedIn();
    }

    // =========================
    // Free access (whitelist)
    // =========================
    match /freeAccessUsers/{email} {
      allow read: if signedIn();
      // optional: allow admin to manage whitelist
      allow create, update, delete: if isAdmin();
    }

    // =========================
    // Users
    // =========================
    match /users/{userId} {
      // user can access own doc; admin can access any
      allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    // =========================
    // Videos (public read, admin write)
    // =========================
    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;

        // signed-in user creates self-authored comment with non-empty text
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;

        // author OR admin can delete
        allow delete: if signedIn()
          && (request.auth.uid == resource.data.userId || isAdmin());

        // no edits
        allow update: if false;
      }
    }

    // =========================
    // Quotes (public read, admin write)
    // =========================
    match /quotes/{quoteId} {
      allow read: if true;

      function isValidQuote(d) {
        return d.text is string && d.text.size() > 0
          && d.author is string && d.author.size() > 0
          && d.language in ['EN','PT'];
      }

      allow create: if isAdmin() && isValidQuote(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // =========================
    // Admins list
    // =========================
    match /admins/{uid} {
      // only admins can see/manage the admins list
      allow read, create, update, delete: if isAdmin();
    }

    // =========================
    // Admin-only stats
    // =========================
    match /stats/{docId} {
      allow read, write: if isAdmin();
    }

    match /admin_monthly/{docId} {
      allow read, write: if isAdmin();
    }

    // =========================
    // Email queue: nobody from client
    // =========================
    match /email_queue/{docId} {
      allow read, write: if false;
    }
  }
}
